  <version>0.1.0</version>
  <description>Jembatan node ROS2 (C++) ke Pixhawk lewat MAVROS</description>
  <maintainer email="tim@example.com">Tim Dagozilla</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>mavros_msgs</depend>
